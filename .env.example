# EmailJS credentials — create a free account at https://www.emailjs.com/
# Copy this file to `.env` and fill in the values from your EmailJS dashboard.
# When these are empty/absent, the contact form gracefully falls back to mailto:.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
